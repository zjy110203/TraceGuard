{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traceguard.local/contracts/C06_Evidence.schema.json",
  "title": "C06 Evidence Record — DRAFT (stage 4 illustrative, NOT frozen)",
  "description": "DRAFT 非冻结示例结构。layer 三态严格分离；integrity_check 与 source_trust 独立字段；derived 必须声明 derived_from 与 derivation_rule。",
  "type": "object",
  "required": [
    "evidence_id", "layer", "evidence_type", "source", "run_id", "recorded_at",
    "integrity_check", "source_trust", "derived_from", "redacted", "retention", "payload"
  ],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "layer": {"enum": ["raw", "normalized", "derived"]},
    "evidence_type": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "run_id": {"type": "string"},
    "step_id": {"type": "string"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "summary": {"type": "string"},
    "integrity_check": {"type": "string"},
    "source_trust": {"enum": ["observed", "independent_api", "normalized", "derived"]},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "derivation_rule": {"type": "string"},
    "redacted": {"type": "boolean"},
    "retention": {"enum": ["run_scoped", "experiment_scoped", "long_term"]},
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"layer": {"const": "derived"}}, "required": ["layer"]},
      "then": {
        "properties": {
          "derived_from": {"type": "array", "minItems": 1},
          "derivation_rule": {"type": "string", "minLength": 1}
        }
      }
    }
  ],
  "additionalProperties": false
}
