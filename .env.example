# TraceGuard 环境变量样例
# 复制为 .env 后按需修改。真实密钥绝不入库（.env 已被 .gitignore 忽略）。

# ---- 运行模式 ----
APP_ENV=dev                       # dev | test | prod
LOG_LEVEL=INFO
LOG_JSON=false                    # prod 建议 true，结构化日志

# ---- 数据库 ----
# 默认 SQLite，零外部依赖，开箱即跑：
DATABASE_URL=sqlite:///./data/traceguard.db
# 切换 PostgreSQL（需先 docker compose -f infra/docker-compose.yml up -d）：
# DATABASE_URL=postgresql+psycopg://tg:tg@localhost:5432/traceguard

# ---- 平台主服务 ----
API_HOST=127.0.0.1
API_PORT=8000
WORKBENCH_WORKERS=1            # 本机单用户部署强制单 Worker
DATA_LEASE_HEARTBEAT_SECONDS=20
DATA_LEASE_TIMEOUT_SECONDS=60

# ---- TeamFlow 被测应用 ----
TEAMFLOW_HOST=127.0.0.1
TEAMFLOW_PORT=8001
# 初始测试账户（演示用明文，prod 必须为 hash；见 teamflow/auth）
TEAMFLOW_TEST_USER=tester
TEAMFLOW_TEST_PASSWORD=test-pass-123

# ---- Eval 控制面（Ground Truth / 故障注入）----
# 独立令牌，仅评测侧持有；Agent 与被测业务面不得读取此值。
# 生产环境必须替换为强随机值，例如：python -c "import secrets;print(secrets.token_urlsafe(32))"
EVAL_CONTROL_TOKEN=local-dev-eval-token-change-me

# ---- Provider binding (configuration only; M4 remains D8-blocked) ----
# LLM_PROVIDER=deepseek | openai
# LLM_ENDPOINT=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# API keys are optional environment secrets; never enable real calls before D8.
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# ---- 密钥不入库占位（本骨架暂不接入，阶段 2+ 使用）----
# JWT_SECRET=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
