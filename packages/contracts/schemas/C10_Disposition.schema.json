{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traceguard.local/contracts/C10/0.2.0-draft",
  "title": "Disposition",
  "description": "Disposition 维度契约：Diagnosis 的 routing 视图。字段均来源于 packages/agents/diagnosis.py 的 Diagnosis，无新增字段。",
  "status": "draft",
  "type": "object",
  "properties": {
    "diagnosis_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "diagnosis_status": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "INCONCLUSIVE",
        "PROBABLE"
      ]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "AGENT_ISSUE",
        "ENVIRONMENT_ISSUE",
        "MANUAL_REVIEW",
        "NEEDS_MORE_EVIDENCE",
        "PLATFORM_ISSUE",
        "PRODUCT_DEFECT",
        "TEST_ASSET_ISSUE",
        "TEST_EXECUTION_ISSUE"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "diagnosis_id",
    "run_id",
    "diagnosis_status",
    "disposition"
  ],
  "additionalProperties": false
}
